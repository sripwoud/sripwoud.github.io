amends "package://github.com/jdx/hk/releases/download/v1.1.1/hk@1.1.1#/Config.pkl"

local checks  = new Mapping<String, Step> {
  ["install"]  {
    glob = List("package.json", "bun.lock")
    check = "mise run install"
  }
  ["biome"]  {
    check = "mise run check:lint"
  }
  ["deps"]  {
    depends = "install"
    check = "mise run check:deps"
  }
  ["dprint"]  {
    fix = "dprint fmt"
    stage = "*"
  }
  ["typescript"]  {
    depends = "install"
    check = "mise run check:types"
  }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = checks
    }
}
