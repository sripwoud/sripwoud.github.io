amends "package://github.com/jdx/hk/releases/download/v1.47.0/hk@1.47.0#/Config.pkl"

local checks  = new Mapping<String, Step> {
  ["biome"]  {
    check = "mise run check:lint"
  }
  ["dprint"]  {
    fix = "dprint fmt"
    stage = "*"
  }
  ["typescript"]  {
    check = "mise run check:types"
  }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = checks
    }
}
